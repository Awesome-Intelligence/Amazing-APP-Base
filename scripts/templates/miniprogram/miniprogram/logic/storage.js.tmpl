// 存储适配 —— **全小程序只有这个文件认识 wx**。
//
// 业务逻辑（store.js）只认 get/set 两个方法，所以它能在 node 里跑测试。
function wxStorage() {
  return {
    get: (key) => wx.getStorageSync(key),
    set: (key, value) => wx.setStorageSync(key, value),
  }
}

// 内存版 —— 单元测试用（每条样例一份，互不干扰）
function memoryStorage() {
  const map = {}
  return {
    get: (key) => map[key],
    set: (key, value) => {
      map[key] = value
    },
  }
}

module.exports = { wxStorage, memoryStorage }
