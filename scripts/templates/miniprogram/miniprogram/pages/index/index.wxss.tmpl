.page {
  padding: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 12rpx;
}

.primary {
  background: #1D1915;
  color: #fff;
  font-size: 28rpx;
}

.todo {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #E7E5E4;
}

.title {
  flex: 1;
}

.ghost {
  background: transparent;
  color: #78716C;
  font-size: 24rpx;
}

.empty {
  padding: 60rpx 0;
  color: #A8A29E;
  text-align: center;
}
